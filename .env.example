# Supabase project settings
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never prefix this value with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional separate HMAC salt for rate-limit identifiers; defaults to the service role key.
RATE_LIMIT_HMAC_SECRET=

# Server-side email notifications (Resend)
RESEND_API_KEY=re_...
INQUIRY_NOTIFICATION_EMAIL=owner@example.com
INQUIRY_FROM_EMAIL=Portfolio inquiries <onboarding@resend.dev>
